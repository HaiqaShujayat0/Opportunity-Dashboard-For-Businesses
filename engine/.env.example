# Engine 1 — Environment Variables Example
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file to git.

# Django
DJANGO_SECRET_KEY=replace-with-a-secure-random-string
DJANGO_DEBUG=True

DATABASE_URL=postgresql://opportunity_engine_user:your_db_password_here@localhost:5432/opportunity_engine
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0


# DataForSEO API Credentials
DATAFORSEO_LOGIN=your_dataforseo_email@example.com
DATAFORSEO_PASSWORD=your_dataforseo_api_key_or_password


# Google — Service Account (one key for GSC + GA4 + Sheets)
GOOGLE_API_SERVICE_ACCOUNT_FILE=../path-to-your-service-account-file.json
GOOGLE_SHEETS_SERVICE_ACCOUNT_FILE=../path-to-your-service-account-file.json


# Google Sheets Automatic Provisioning
GOOGLE_DRIVE_PARENT_FOLDER_ID=your_google_drive_folder_id_here
ADMIN_GOOGLE_EMAIL=your_admin_email_to_share_sheets_with@example.com


# Testing & Dummy Flags
# Set to True if you don't have GSC/GA4 setup yet
GOOGLE_USE_DUMMY_DATA=True
# Set to True if you don't have Google Sheets API setup yet
USE_DUMMY_SHEETS=False
